# ==========================================
# RECHAT APPLICATION ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# MYSQL_USER phai la user thuong (image mysql:8 khong cho phep MYSQL_USER=root)
MYSQL_USER=rechat_user
MYSQL_PASSWORD=rechat_password
MYSQL_DATABASE=rechat_db
# Chi dung cho container MySQL / Adminer trong docker-compose.yml
MYSQL_ROOT_PASSWORD=root_password
ADMINER_PORT=8080

# ------------------------------------------
# 3. REDIS CONFIGURATION (Cache, Sessions & Presence)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# 4. JWT AUTHENTICATION
# ------------------------------------------
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m

# ------------------------------------------
# 5. EMAIL / SMTP (Nodemailer & BullMQ)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
MAIL_FROM="ReChat Team" <noreply@rechat.app>

# ------------------------------------------
# 6. CLOUDINARY CONFIGURATION (Media & File Storage)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
