# ==========================================
# RECHAT APPLICATION ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rechat_db

# ------------------------------------------
# 3. REDIS CONFIGURATION (Cache, Sessions & Presence)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# 4. JWT AUTHENTICATION
# ------------------------------------------
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m

# ------------------------------------------
# 5. EMAIL / SMTP (Nodemailer & BullMQ)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
MAIL_FROM="ReChat Team" <noreply@rechat.app>

# ------------------------------------------
# 6. CLOUDINARY CONFIGURATION (Media & File Storage)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
